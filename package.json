{
  "name": "Ecom",
  "private": true,
  "scripts": {
    "build": "npm run build:storefront && npm run build:admin && npm run build:api",
    "build:storefront": "npm --prefix apps/storefront-vite run build",
    "build:admin": "npm --prefix apps/admin-vite run build",
    "build:api": "npm --prefix apps/api run build",
    "dev:storefront": "npm --prefix apps/storefront-vite run dev",
    "dev:admin": "npm --prefix apps/admin-vite run dev",
    "dev:api": "npm --prefix apps/api run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
